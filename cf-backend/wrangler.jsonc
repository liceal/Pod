{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pod-quick-backend",
	"main": "src/index.ts",
	"compatibility_date": "2024-03-20",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "../mobile-web/dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pod-quick",
			"database_id": "YOUR_D1_DATABASE_ID"
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES_BUCKET",
			"bucket_name": "pod-quick-files"
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"ENABLE_PERF_LOGS": "true"
	},
	"env": {
		"dev": {
			"vars": {
				"ENVIRONMENT": "development",
				"ENABLE_PERF_LOGS": "true"
			}
		}
	}
}