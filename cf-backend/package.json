{
  "name": "pod-quick-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build:web": "cd ../mobile-web && pnpm build",
    "deploy": "pnpm run build:web && wrangler deploy",
    "d1:init:local": "wrangler d1 execute pod-quick --local --file=./schema.sql",
    "d1:init:remote": "wrangler d1 execute pod-quick --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240320.0",
    "typescript": "^5.4.2",
    "wrangler": "^3.34.0"
  }
}
